            "analysis.Clip",
            "management.Project",
            "management.Dissolve",
            "conversion.FeaturesToJSON",
            "analysis.SpatialJoin"
          ]
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 4096
