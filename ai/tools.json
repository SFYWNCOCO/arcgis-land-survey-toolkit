[
  {
    "name": "open_acceptance_workspace",
    "description": "切换统一补充耕地验收工作台的AI助手或采样与出图页面；复用已填写的页面与任务状态，不自动执行采样或改动业务数据。",
    "inputSchema": {"type":"object","properties":{"page":{"type":"string","enum":["assistant","sampling"]}},"required":["page"],"additionalProperties":false},
    "annotations": {"readOnlyHint":true},
    "_meta": {"pro-ai-bridge/context":"project"}
  },
  {
    "name": "list_basemap_sources",
    "description": "列出六类底图来源（天地图影像/矢量/地形晕渲、高德卫星/矢量、高德行政区划区图）的本机配置状态、坐标系与纠偏/精度限制；不返回密钥。高德来源为 GCJ-02，须纠偏后才可与 CGCS2000 数据叠加；阿里云或单位授权服务通过采样助手 XYZ/WMTS 配置。",
    "inputSchema": {"type":"object","properties":{},"additionalProperties":false},
    "annotations": {"readOnlyHint":true},
    "_meta": {"pro-ai-bridge/context":"project"}
  },
  {
    "name": "open_basemap_preview",
    "description": "在浏览器打开官方高德/天地图预览，仅供浏览参考，不写入业务地块。密钥先在侧栏底图设置保存。可同时指定 WGS84 经纬度，否则使用当前地图中心。返回 PAGE_OPENED 仅表示页面打开，不代表提供商已加载或精度合格。行政区划区图不支持浏览器预览，请用 add_basemap 加载矢量图层。",
    "inputSchema": {"type":"object","properties":{
      "source":{"type":"string","enum":["amap_vector","amap_satellite","tianditu_vector","tianditu_image","tianditu_terrain"]},
      "longitude":{"type":"number","minimum":-180,"maximum":180},
      "latitude":{"type":"number","minimum":-85,"maximum":85},
      "confirm":{"type":"boolean","enum":[true]}
    },"required":["source","confirm"],"additionalProperties":false},
    "annotations": {"readOnlyHint":false,"destructiveHint":false,"openWorldHint":true},
    "_meta": {"pro-ai-bridge/context":"map"}
  },
