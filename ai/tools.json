  {
    "name": "run_geoprocessing",
    "description": "运行白名单地理处理工具；parameters依次为工具的字符串参数。禁止覆盖已有输出。缓冲/裁剪/投影/融合先查询字段与坐标系；耗时工具返回任务ID，用get_job查询、cancel_job取消。必须confirm=true。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "enum": [
            "management.GetCount",
            "management.CopyFeatures",
